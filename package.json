{
  "name": "red-vs-blue",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "pages:dev": "wrangler pages dev",
    "pages:deploy": "wrangler pages deploy dist",
    "db:init:local": "wrangler d1 execute red-vs-blue --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute red-vs-blue --remote --file=./schema.sql",
    "db:migrate:share-code:local": "wrangler d1 execute red-vs-blue --local --file=./migrations/0001_add_share_code.sql",
    "db:migrate:share-code:remote": "wrangler d1 execute red-vs-blue --remote --file=./migrations/0001_add_share_code.sql",
    "db:backfill:share-code:local": "node scripts/backfill-share-codes.mjs --local",
    "db:backfill:share-code:remote": "node scripts/backfill-share-codes.mjs --remote"
  },
  "dependencies": {
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "workers-og": "^0.0.27"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "wrangler": "^4.86.0"
  }
}
